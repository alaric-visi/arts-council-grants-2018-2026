---
import Layout from '../layouts/Layout.astro';
import { ArtsCouncilExplorer } from '../components/arts-council-explorer';
---

<Layout
  title="Arts Council Funding Grants 2018–2026 — Comprehensive Data Explorer"
  description="Interactive data explorer and analytics dashboard for Arts Council England National Lottery Project Grants (2018–19 onwards). Explore 15,000+ grants, recipients, disciplines, and regional allocations."
>
  <main class="flex-1 flex flex-col min-h-screen">
    <ArtsCouncilExplorer
      client:only="react"
      basePath=""
      backHref="https://mikehiggins.me.uk"
      backLabel="Mike Higgins"
      citationName="Arts Council Funding Explorer (grants.mikehiggins.me.uk)"
    />

    <noscript>
      <div class="p-8 max-w-4xl mx-auto space-y-6 text-white/90">
        <h1 class="text-3xl font-bold tracking-tight text-white">
          Arts Council England Funding Grants (2018–2026)
        </h1>
        <p class="text-base text-white/70 leading-relaxed">
          Comprehensive public funding archive indexing over <strong class="text-white">£800.7M+</strong> across <strong class="text-white">27,000+</strong> National Lottery Project Grants awarded by Arts Council England to more than <strong class="text-white">15,000+</strong> individual recipients, cultural organisations, and festivals across England.
        </p>

        <section class="space-y-3">
          <h2 class="text-lg font-semibold text-white">Explore Grant Directories</h2>
          <ul class="flex flex-wrap gap-3 text-sm">
            <li><a href="/grants" class="underline text-emerald-400 hover:text-emerald-300">All Grants Directory</a></li>
            <li><a href="/analytics" class="underline text-emerald-400 hover:text-emerald-300">Funding Analytics & Trends</a></li>
            <li><a href="/map" class="underline text-emerald-400 hover:text-emerald-300">Local Authority Geographic Map</a></li>
            <li><a href="/compare" class="underline text-emerald-400 hover:text-emerald-300">Comparative Dimensions</a></li>
            <li><a href="/about" class="underline text-emerald-400 hover:text-emerald-300">Methodology & Sources</a></li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg font-semibold text-white">Artistic Disciplines</h2>
          <ul class="flex flex-wrap gap-2 text-sm text-white/80">
            <li><a href="/disciplines/theatre" class="underline hover:text-white">Theatre</a> ·</li>
            <li><a href="/disciplines/music" class="underline hover:text-white">Music</a> ·</li>
            <li><a href="/disciplines/visual-arts" class="underline hover:text-white">Visual Arts</a> ·</li>
            <li><a href="/disciplines/dance" class="underline hover:text-white">Dance</a> ·</li>
            <li><a href="/disciplines/literature" class="underline hover:text-white">Literature</a> ·</li>
            <li><a href="/disciplines/combined-arts" class="underline hover:text-white">Combined Arts</a> ·</li>
            <li><a href="/disciplines/museums" class="underline hover:text-white">Museums</a></li>
          </ul>
        </section>

        <p class="text-xs text-white/50 pt-4 border-t border-white/10 font-mono">
          Note: JavaScript is required for interactive crossfiltering, dynamic map visualizations, and CSV dataset export.
        </p>
      </div>
    </noscript>
  </main>
</Layout>
