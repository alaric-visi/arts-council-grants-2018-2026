---
import Layout from '../layouts/Layout.astro';
import { ArtsCouncilExplorer } from '../components/arts-council-explorer';

export const prerender = false;

const pathname = Astro.url.pathname;
---

<Layout
  title="Arts Council Funding Grants 2018–2026"
  description="Interactive data explorer and analytics dashboard for Arts Council England National Lottery Project Grants (2018–19 onwards)."
  canonicalPath={pathname}
>
  <main class="flex-1 flex flex-col min-h-screen">
    <ArtsCouncilExplorer
      client:only="react"
      basePath=""
      backHref="https://mikehiggins.me.uk"
      backLabel="Mike Higgins"
      citationName="Arts Council Funding Explorer (grants.mikehiggins.me.uk)"
    />

    <noscript>
      <div class="p-8 max-w-4xl mx-auto space-y-6 text-white/90">
        <h1 class="text-3xl font-bold tracking-tight text-white">
          Arts Council England Funding Grants (2018–2026)
        </h1>
        <p class="text-base text-white/70 leading-relaxed">
          Comprehensive public funding archive indexing over <strong class="text-white">£800.7M+</strong> across <strong class="text-white">27,000+</strong> National Lottery Project Grants awarded by Arts Council England.
        </p>
        <p class="text-sm">
          <a href="/" class="underline text-emerald-400 hover:text-emerald-300">Return to Full Grants Explorer</a>
        </p>
      </div>
    </noscript>
  </main>
</Layout>
